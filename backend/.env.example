LAW_ENV=development
LAW_DATABASE_URL=postgresql+asyncpg://law_admin:replace_me@127.0.0.1:55432/law_dev
LAW_ALLOW_DEV_LOGIN=false
LAW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 留空时返回 503，绝不回退 Mock AI。DeepSeek 模型名以账号当前可用模型为准。
LAW_DEEPSEEK_API_KEY=
LAW_DEEPSEEK_BASE_URL=https://api.deepseek.com
LAW_DEEPSEEK_MODEL=deepseek-flash
# 结构化分析/文书使用非思考 JSON 输出；流式对话保持独立输出预算。
LAW_STRUCTURED_OUTPUT_TOKENS=8192
LAW_EMBEDDING_API_KEY=
LAW_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LAW_EMBEDDING_MODEL=text-embedding-v4
LAW_OCR_PROVIDER=alibaba
LAW_OCR_ACCESS_KEY_ID=
LAW_OCR_ACCESS_KEY_SECRET=
LAW_OCR_REGION=cn-hangzhou
LAW_OCR_MODEL=RecognizeGeneral
LAW_OCR_MIN_CONFIDENCE=0.85
LAW_OCR_MAX_PAGES=100
# 当前数据库固定 1536 维；变更需迁移并全量重建索引。
LAW_EMBEDDING_DIMENSIONS=1536
LAW_S3_ENDPOINT_URL=http://127.0.0.1:59000
LAW_S3_REGION=us-east-1
LAW_S3_ACCESS_KEY_ID=replace_me
LAW_S3_SECRET_ACCESS_KEY=replace_me
LAW_S3_BUCKET=law-private
LAW_WECHAT_APP_ID=
LAW_WECHAT_APP_SECRET=
# 美元/百万 token，空值保持 cost_usd=null，不能把未知费用当作 0。
LAW_INPUT_USD_PER_MILLION=
LAW_OUTPUT_USD_PER_MILLION=
