LAW_ENV=development
LAW_DATABASE_URL=postgresql+asyncpg://law_admin:replace_me@127.0.0.1:55432/law_dev
LAW_ALLOW_DEV_LOGIN=false
LAW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 留空时返回 503，绝不回退 Mock AI。DeepSeek 模型名以账号当前可用模型为准。
LAW_DEEPSEEK_API_KEY=
LAW_DEEPSEEK_BASE_URL=https://api.deepseek.com
LAW_DEEPSEEK_MODEL=deepseek-flash
# 切换阿里云百炼时替换以上三项；API Key、Base URL 与模型 ID 以同地域控制台为准。
# LAW_DEEPSEEK_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LAW_DEEPSEEK_MODEL=deepseek-v4.1-flash-1017
# 百炼流式对话与 JSON 分析均使用 enable_thinking=false；官方 JSON 分析使用 thinking.type=disabled。
# 结构化分析/文书使用非思考 JSON 输出；流式对话保持独立输出预算。
LAW_STRUCTURED_OUTPUT_TOKENS=8192
# 案件问答启用受限的只读工具循环；通用助手不获得案件工具。
# 关闭后恢复固定检索 + 流式回答，不会在工具失败时自动降级或重复计费。
LAW_TOOL_CALLING_ENABLED=true
LAW_AGENT_MAX_ROUNDS=4
LAW_AGENT_MAX_TOOL_CALLS=8
LAW_AGENT_MAX_TOOL_ERRORS=3
LAW_TOOL_TIMEOUT_SECONDS=15
LAW_TOOL_MAX_ARGUMENT_CHARS=4096
LAW_TOOL_MAX_RESULT_CHARS=4000
# 独立 LangGraph 案件研判，异步 Worker 执行，关键背景缺失时暂停等待补充。
LAW_ASSESSMENT_ENABLED=true
LAW_ASSESSMENT_TIMEOUT_SECONDS=180
LAW_ASSESSMENT_MAX_MODEL_CALLS=8
LAW_ASSESSMENT_MAX_TOOL_CALLS=8
LAW_ASSESSMENT_MAX_SEARCH_ROUNDS=3
LAW_EMBEDDING_API_KEY=
LAW_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LAW_EMBEDDING_MODEL=text-embedding-v4
# 可选 Cross-Encoder 重排；开启后 RRF Top-N 经 BGE-Reranker 精排。
# 支持 SiliconFlow `/v1/rerank`（BAAI/bge-reranker-v2-m3）或百炼 `services/rerank/text-rerank/text-rerank`（gte-rerank-v2）。
LAW_RERANK_ENABLED=false
LAW_RERANK_API_KEY=
LAW_RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
LAW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LAW_RERANK_CANDIDATES=20
LAW_OCR_PROVIDER=alibaba
LAW_OCR_ACCESS_KEY_ID=
LAW_OCR_ACCESS_KEY_SECRET=
LAW_OCR_REGION=cn-hangzhou
LAW_OCR_MODEL=RecognizeGeneral
LAW_OCR_MIN_CONFIDENCE=0.85
LAW_OCR_MAX_PAGES=100
# 当前数据库固定 1536 维；变更需迁移并全量重建索引。
LAW_EMBEDDING_DIMENSIONS=1536
LAW_S3_ENDPOINT_URL=http://127.0.0.1:59000
LAW_S3_REGION=us-east-1
LAW_S3_ACCESS_KEY_ID=replace_me
LAW_S3_SECRET_ACCESS_KEY=replace_me
LAW_S3_BUCKET=law-private
LAW_WECHAT_APP_ID=
LAW_WECHAT_APP_SECRET=
# 美元/百万 token，空值保持 cost_usd=null，不能把未知费用当作 0。
LAW_INPUT_USD_PER_MILLION=
LAW_OUTPUT_USD_PER_MILLION=
# 可选离线脱敏判例结构特征 JSONL 路径（仅作同结构判例结果参照，不改变未校准胜诉率分值）。
# LAW_PRECEDENT_REFERENCE_PATH=
